# Copy this file to .env.docker and edit DOCKERHUB_USERNAME before building/pushing.
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=1.0.0

# Local Compose database settings. Use a URL-safe password (letters/numbers/dashes).
POSTGRES_DB=geofence
POSTGRES_USER=geofence
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433

# These are embedded into the frontend at build time and exposed by Compose.
VITE_API_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:8080
API_PORT=3000
WEB_PORT=8080
